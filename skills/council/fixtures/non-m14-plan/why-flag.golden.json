    },
    "4_prosecution_defense": {
      "advocate": {
        "evidence_field": "evidence_for",
        "flavor": "yolo-ic",
        "prompt": "skills/council/prompts/phase4-brief.md",
        "role": "Devil's Advocate"
      },
      "prosecutor": {
        "evidence_field": "evidence_against",
        "flavor": "jaded-senior",
        "prompt": "skills/council/prompts/phase4-brief.md",
        "role": "Prosecutor"
      }
    },
    "5_judgment": {
      "agent": "council-judge",
      "inputs": [
        "claims",
        "evidence_bundles",
        "prosecutor_brief",
        "advocate_brief"
      ],
      "prompt": "skills/council/prompts/judge.md"
    },
    "6_finalize": {
      "invoke": "engine.sh finalize --plan-file <p> --evidence-file <e> --judge-output <j>"
    }
  },
